# Copia este archivo a .env y rellena los valores. .env esta en .gitignore.

# --- Obligatorio para registrar ---------------------------------------------
# Token de CUENTA, sacado del dashboard: https://my.spacetraders.io
# Es el unico token que acepta POST /register. No es el token del agente.
SPACETRADERS_ACCOUNT_TOKEN=

# Nombre de tu agente: 3 a 14 caracteres. Prefija el simbolo de cada nave.
SPACETRADERS_AGENT_SYMBOL=MOIBE_1

# Faccion inicial: define tu sistema de origen.
# Opciones: COSMIC, VOID, GALACTIC, QUANTUM, DOMINION, ASTRO, CORSAIRS, OBSIDIAN,
# AEGIS, UNITED, SOLITARY, COBALT, OMEGA, ECHO, LORDS, CULT, ANCIENTS, SHADOW, ETHEREAL
SPACETRADERS_FACTION=COSMIC

# --- Opcionales -------------------------------------------------------------
# Salida de emergencia: si el simbolo ya esta reclamado en esta temporada, la API
# no permite recuperar su token. Pegalo aca desde el dashboard y el cliente se
# saltea el registro.
# SPACETRADERS_AGENT_TOKEN=

# Donde guardar el token del agente (default: .spacetraders/agent.json)
# SPACETRADERS_TOKEN_FILE=.spacetraders/agent.json

# Poner en 0 para que un reset del servidor falle con error en vez de re-registrar
# el agente automaticamente (default: 1)
# SPACETRADERS_AUTO_REREGISTER=1

# Ajustes del cliente HTTP
# SPACETRADERS_TIMEOUT=30
# SPACETRADERS_MAX_RETRIES=5
# SPACETRADERS_BASE_URL=https://api.spacetraders.io/v2
